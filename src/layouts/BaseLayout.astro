---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = '记录技术、生活与一路上的思考',
} = Astro.props;
const pageTitle = title ? `${title} · Bella's Blog` : `Bella's Blog`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title="Bella's Blog" href={`${base}rss.xml`} />
    <title>{pageTitle}</title>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
    </script>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href={base} aria-label="返回首页">
          <span class="brand-mark">B</span><span>Bella's Blog</span>
        </a>
        <nav aria-label="主导航">
          <a href={base}>文章</a>
          <a href={`${base}about/`}>关于</a>
          <a href="https://github.com/bellabiu888" target="_blank" rel="noreferrer">GitHub ↗</a>
          <button class="theme-toggle" type="button" aria-label="切换深色模式">◐</button>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">© {new Date().getFullYear()} Bella · 用文字记录正在发生的事</footer>
    </div>
    <script>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
